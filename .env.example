# .env.example — Copia como .env en el servidor Azure y llena los valores
# NUNCA subas el .env real a git

# ── GitHub ─────────────────────────────────────────────────────────────────────
# Tu usuario de GitHub (en minúsculas)
GITHUB_OWNER=tu-usuario-github

# ── Base de datos ──────────────────────────────────────────────────────────────
POSTGRES_USER=mano
# Genera con: openssl rand -hex 16
POSTGRES_PASSWORD=CAMBIA_ESTO
POSTGRES_DB=mano

# ── Redis ──────────────────────────────────────────────────────────────────────
# Genera con: openssl rand -hex 16
REDIS_PASSWORD=CAMBIA_ESTO

# ── Backend ────────────────────────────────────────────────────────────────────
# Genera con: openssl rand -hex 32
JWT_SECRET=GENERA_CON_OPENSSL_RAND_HEX_32

# URL pública de la app — tu dominio comprado en AWS Route 53
APP_BASE_URL=https://TU_DOMINIO.COM

# SIEMPRE false en producción
MOCK_MODE=false

# ── Wompi (pagos Colombia) ─────────────────────────────────────────────────────
# Obtener en: https://dashboard.wompi.co → Developers → API Keys
WOMPI_PUBLIC_KEY=pub_prod_...
WOMPI_PRIVATE_KEY=prv_prod_...
WOMPI_INTEGRITY_SECRET=...
WOMPI_EVENTS_SECRET=...

# ── Email (notificaciones al negocio) ─────────────────────────────────────────
# Opción A — Gmail con App Password (más fácil para empezar):
#   1. Activar 2FA en tu cuenta Gmail
#   2. Ir a myaccount.google.com → Seguridad → Contraseñas de aplicaciones
#   3. Generar contraseña para "Correo"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
FROM_EMAIL=noreply@TU_DOMINIO.COM

# Opción B — SendGrid (100 emails/día gratis):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxxxxxxxxx

# ── Frontend ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=/api
