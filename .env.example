# .env.example — Copia como .env en el servidor Azure y llena los valores
# NUNCA subas el .env real a git

# ── GitHub ─────────────────────────────────────────────────────────────────────
# Tu usuario de GitHub (en minúsculas)
GITHUB_OWNER=tu-usuario-github

# ── Base de datos ──────────────────────────────────────────────────────────────
POSTGRES_USER=mano
# Genera con: openssl rand -hex 16
POSTGRES_PASSWORD=CAMBIA_ESTO
POSTGRES_DB=mano

# ── Redis ──────────────────────────────────────────────────────────────────────
# Genera con: openssl rand -hex 16
REDIS_PASSWORD=CAMBIA_ESTO

# ── Backend ────────────────────────────────────────────────────────────────────
# Genera con: openssl rand -hex 32
JWT_SECRET=GENERA_CON_OPENSSL_RAND_HEX_32

# URL pública de la app (https obligatorio: Wompi no acepta http para el regreso del comprador)
APP_BASE_URL=https://TU_DOMINIO.COM
# Dominio sin https:// ni www (nginx lo usa para el certificado y el server_name)
DOMAIN=TU_DOMINIO.COM

# MOCK_MODE y SEED_DEMO_DATA los fija docker-compose.prod.yml en false: no se configuran aquí.

# Primer administrador (solo se crea si todavía no existe ninguno). ADMIN_PASSWORD: mínimo 12 caracteres,
# generado por ti (openssl rand -base64 18). Quita ADMIN_PASSWORD de este archivo tras el primer arranque.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Wompi (pagos Colombia) ─────────────────────────────────────────────────────
# Obtener en comercios.wompi.co → Desarrollo → Programadores.
# PRIMER DESPLIEGUE: usa las llaves de PRUEBAS (pub_test_ / prv_test_ / test_integrity_ / test_events_):
# con ellas se paga con dinero ficticio. Cambia a pub_prod_ / prv_prod_ solo cuando todo esté probado.
# El backend elige sandbox o producción según el prefijo de WOMPI_PUBLIC_KEY.
WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_INTEGRITY_SECRET=test_integrity_...
WOMPI_EVENTS_SECRET=test_events_...
# En Wompi (mismo ambiente) → URL de Eventos: https://TU_DOMINIO.COM/api/webhooks/wompi

# ── Email (notificaciones al negocio) ─────────────────────────────────────────
# Opción A — Gmail con App Password (más fácil para empezar):
#   1. Activar 2FA en tu cuenta Gmail
#   2. Ir a myaccount.google.com → Seguridad → Contraseñas de aplicaciones
#   3. Generar contraseña para "Correo"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
FROM_EMAIL=noreply@TU_DOMINIO.COM

# Opción B — SendGrid (100 emails/día gratis):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxxxxxxxxx

# ── Frontend ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=/api
