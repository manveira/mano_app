# .env.local.example — Variables del entorno LOCAL (docker-compose.local.yml).
# Copia a `.env.local` solo si necesitas cambiar algo; todos tienen valor por defecto.
# `.env.local` está en .gitignore. NUNCA pongas credenciales de producción aquí.

# Postgres local
LOCAL_POSTGRES_USER=user
LOCAL_POSTGRES_PASSWORD=pass
LOCAL_POSTGRES_DB=mano
LOCAL_POSTGRES_PORT=5433

# Backend
LOCAL_CORE_PORT=8080
LOCAL_JWT_SECRET=local-dev-secret-change-me
LOCAL_APP_BASE_URL=http://localhost:3000

# Wompi SANDBOX (opcional; sin esto, MOCK_MODE=true simula los pagos)
# Dashboard Wompi (comercios.wompi.co) → Desarrolladores → Activar modo de pruebas (Sandbox). Procedimiento: docs/WOMPI_SANDBOX.md y `bash scripts/wompi-sandbox.sh up` (pone LOCAL_APP_BASE_URL con el túnel https)
# Prefijos: pub_test_ / prv_test_ / test_integrity_ / test_events_. Con claves puestas, el checkout y el webhook usan el código real de Wompi (MOCK_MODE sigue activo solo para los endpoints /mock).
LOCAL_WOMPI_PUBLIC_KEY=
LOCAL_WOMPI_PRIVATE_KEY=
LOCAL_WOMPI_INTEGRITY_SECRET=
LOCAL_WOMPI_EVENTS_SECRET=
